{
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "mahzoof": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "vazirmatn-arabic-*-normal.woff2",
                "input": "node_modules/@fontsource/vazirmatn/files",
                "output": "fonts/vazirmatn"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.rtl.min.css",
              "node_modules/ag-grid-community/styles/ag-grid.css",
              "node_modules/ag-grid-community/styles/ag-theme-material.css",
              "node_modules/select2/dist/css/select2.min.css",
              "node_modules/@yaireo/tagify/dist/tagify.css",
              "node_modules/sweetalert2/dist/sweetalert2.min.css",
              "src/styles.css",
              "src/grid.css",
              "src/student-form.css",
              "src/select2.css",
              "src/panel-theme.css"
            ],
            "outputPath": "dist/mahzoof",
            "index": "src/index.html",
            "allowedCommonJsDependencies": [
              "jalaali-js",
              "jquery",
              "select2/dist/js/select2.js"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kB",
                  "maximumError": "1.5MB"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "mahzoof:build:development"
            },
            "production": {
              "buildTarget": "mahzoof:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
