[Unit]
Description=Mahzoof Music Manager
After=network.target

[Service]
Type=simple
User=mahzoof
Group=mahzoof
WorkingDirectory=/opt/mahzoof
EnvironmentFile=/etc/mahzoof/mahzoof.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/mahzoof

[Install]
WantedBy=multi-user.target
