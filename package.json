{
  "name": "mahzoof-music-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "ng build",
    "test": "node --test server/test/*.test.mjs",
    "admin": "node --env-file-if-exists=.env server/cli.mjs",
    "migrate": "node --env-file-if-exists=.env server/migrate.mjs",
    "e2e": "playwright test --max-failures=1",
    "seed": "node --env-file-if-exists=.env server/seed.mjs",
    "backup": "node --env-file-if-exists=.env server/backup.mjs",
    "check": "ngc -p tsconfig.app.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"src/styles.css\" \"server/**/*.mjs\" \"e2e/*\" playwright.config.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "ag-grid-community": "36.2.0",
    "bootstrap": "5.3.8",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jalaali-js": "1.2.8",
    "jquery": "3.7.1",
    "multer": "2.4.0",
    "rxjs": "7.8.2",
    "select2": "4.1.0",
    "sharp": "0.35.5",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "1.64.1",
    "@types/jalaali-js": "1.2.0",
    "@types/jquery": "3.5.33",
    "@types/select2": "4.0.63",
    "prettier": "3.6.2",
    "typescript": "6.0.2"
  }
}
